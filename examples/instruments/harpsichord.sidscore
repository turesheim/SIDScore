; Shared harpsichord-like instrument for Bach and Mozart examples.
; Fixed narrow pulse tone with a crisp attack and a short plucked decay.
; Keep the pitch audible from the start of each note, including ornaments.

INSTR harpsichord
  WAVE=PULSE
  ADSR=0,6,0,3
  PW=$0600
  FILTER=OFF
  GATE=RETRIGGER
  GATEMIN=1
